# ---- Required
DATABASE_URL=postgres://user:password@host:5432/specter
PUBLIC_URL=https://specter.example.com          # the public address of the site, no trailing slash (cookies and redirects use it)

# ---- Discord login and role check (create the application at https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=                              # the Specter bot token: it is only used to read the roles of a member
DISCORD_GUILD_ID=                               # the id of the Specter Discord server
DISCORD_INVITE=https://discord.gg/xxxx          # shown on the support page
ADMIN_DISCORD_IDS=                              # comma separated Discord user ids of the owners (they can make other admins)

# ---- Which Discord roles unlock which Lua (comma separated role ids; the admin page "Discord Role Mapping" overrides these)
LUA1_ROLE_IDS=
LUA2_ROLE_IDS=

# ---- Names and ids (optional, defaults in src/config/site.ts)
# LUA1_NAME=Specter for Gamesense
# LUA1_SLUG=gamesense
# LUA2_NAME=Specter for Primordial
# LUA2_SLUG=primordial

# ---- Monthly job
CRON_SECRET=                                    # at least 24 random characters, the scheduler sends it as a Bearer token

# ---- Optional
# LICENSE_SERVER_URL=https://your-license-server  # the status page pings it
# DATABASE_SSL=1                                   # for databases that require TLS
# DB_POOL_MAX=10

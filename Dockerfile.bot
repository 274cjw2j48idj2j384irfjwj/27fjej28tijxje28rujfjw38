# Discord bot (discord_bot.py) for Railway: set RAILWAY_DOCKERFILE_PATH=Dockerfile.bot on the bot service
FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY discord_bot.py ./
COPY assets/ ./assets/
CMD ["python", "-u", "discord_bot.py"]
